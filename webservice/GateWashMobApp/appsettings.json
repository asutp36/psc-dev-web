{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GateWash": "@connection string@"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "Microsoft.EntityFrameworkCore.Database.Command": "Error",
        "Quartz": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
